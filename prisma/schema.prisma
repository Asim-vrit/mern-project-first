generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id    Int     @id @default(autoincrement())
  name  String
  email String  @unique
  password String
  role Roles @default(STAFF)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}
model Product {
  id    Int     @id @default(autoincrement())
  title  String
  description String
  price Float
  rating Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

enum Roles {
  SUPERUSER
  STAFF
}
